{
  "name": "bandesca",
  "version": "1.0.0",
  "description": "Bandesca is a platform for creating and sharing music",
  "main": "index.js",
  "scripts": {
    "start:static": "BANDESCA_MODE=static npx bun run server/index.js",
    "start:ssr": "BANDESCA_MODE=ssr npx bun run server/index.js",
    "build:static": "BANDESCA_MODE=static npx bun run scripts/build-static.js",
    "build:ssr": "BANDESCA_MODE=ssr npx bun run scripts/build-ssr.js"
  },
  "author": "to-jajav33",
  "license": "MIT",
  "dependencies": {
    "alpinejs": "^3.15.11",
    "bun": "latest"
  }
}
